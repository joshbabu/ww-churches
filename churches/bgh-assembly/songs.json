        "type": "chorus",
        "label": "Chorus",
        "text": "The Lord is my shepherd\nI shall not want"
      },
      {
        "type": "verse",
        "label": "1)",
        "text": "He makes me lie down\nIn green pastures\nBeside still waters"
      },
