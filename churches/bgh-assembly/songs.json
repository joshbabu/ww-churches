    "te": "దేవుని స్తుతించుడి",
    "en": "Praise the Lord",
    "author": "",
    "authorEn": "",
    "lyricsTE": [
      {
        "type": "chorus",
        "label": "పల్లవి",
        "text": "దేవుని స్తుతించుడి\nఆయన మహిమ కొరకు"
      },
      {
        "type": "verse",
        "label": "1)",
        "text": "ఆయన మేలులు మరవకుడి\nప్రతి దినము కృతజ్ఞత చెల్లించుడి"
      },
      {
        "type": "chorusRef",
        "text": "|| దేవుని ||"
      },
      {
        "type": "verse",
        "label": "2)",
        "text": "ఆయన ప్రేమ శాశ్వతమైనది\nఆయన కృప అంతము లేనిది"
      },
      {
        "type": "chorusRef",
        "text": "|| దేవుని ||"
      }
    ],
    "lyricsEN": [
      {
        "type": "chorus",
        "label": "Chorus",
        "text": "Praise the Lord\nFor His glory"
      },
      {
        "type": "verse",
        "label": "1)",
        "text": "Forget not His mercies\nGive thanks every day"
      },
      {
        "type": "chorusRef",
        "text": "|| Praise ||"
      },
      {
        "type": "verse",
        "label": "2)",
        "text": "His love is everlasting\nHis grace has no end"
      },
      {
        "type": "chorusRef",
        "text": "|| Praise ||"
      }
    ]
  },
  {
